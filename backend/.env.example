# Copy to .env and fill in. .env is gitignored.

# Where the pf-idp-processing extraction service is running
EXTRACTION_SERVICE_URL=http://localhost:8000

# Optional. Only used if you start pf-idp-processing from this folder; otherwise
# pf-idp-processing reads its own .env.
GEMINI_API_KEY=

# Seconds to wait for /api/v1/extract before timing out. Cold-starts can be slow.
EXTRACTION_TIMEOUT_SECONDS=120

# Storage: "sqlite" or "json"
STORAGE_BACKEND=sqlite
STORAGE_PATH=./data

# Mock ERP behavior
MOCK_ERP_DEFAULT_MODE=201

# Logging
LOG_LEVEL=INFO

# Demo presenter convenience: if true, shows a small Demo Controls panel
# in the UI (toggle mock ERP, reset state). Set to false for prospect calls.
DEMO_CONTROLS_ENABLED=true
